<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen: the app icon on the theme background.
         Follows the system's dark mode until the app picks a theme; then
         MainActivity sets LaunchTheme.Dark or LaunchTheme.Light for the
         next launches (Android 13+). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    </style>
    <style name="LaunchTheme.Dark">
        <item name="android:windowSplashScreenBackground">@color/launch_background_dark</item>
    </style>
    <style name="LaunchTheme.Light">
        <item name="android:windowSplashScreenBackground">@color/launch_background_light</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
