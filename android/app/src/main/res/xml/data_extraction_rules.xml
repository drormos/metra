<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer. Only the library and the
     settings: their temp files (*.tmp), the version-1 safety copy and the
     corrupt/ folder are left out. Keep in sync with backup_rules.xml and
     LibraryStore. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="library.json" />
        <include domain="file" path="settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
        <include domain="file" path="settings.json" />
    </device-transfer>
</data-extraction-rules>
