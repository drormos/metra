<?xml version="1.0" encoding="utf-8"?>
<!-- audio_service looks up notification button icons by name (its own and
     our tempo steps), so release
     resource shrinking would delete them and the media notification fails
     to build ("You must specify an icon resource id"). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_step_*" />
